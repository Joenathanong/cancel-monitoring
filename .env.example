# ── Database: TiDB Serverless (MySQL 8 compatible) ────────────────────────────
# TiDB Cloud → cluster → Connect → Prisma. WAJIB sslaccept=strict.
# Boleh pakai cluster yang sama dengan app lain, tapi beri nama database sendiri (mis. pending_kiriman).
DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/pdg?sslaccept=strict"

# ── Login aplikasi ────────────────────────────────────────────────────────────
# Minimal 32 karakter acak. Ganti untuk memaksa semua user login ulang.
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
AUTH_SESSION_DAYS=30

# Admin pertama (dibuat oleh `npm run setup` / `npm run db:seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin
SEED_ADMIN_NAME="Administrator"

# ── OCS (status order lewat Find Order) ───────────────────────────────────────
# Akun login ocs.iegsystem.id. Pakai akun yang punya akses SEMUA AREA
# (Pusat + cabang), supaya order cabang juga ditemukan.
OCS_BASE_URL=https:
OCS_USERNAME=
OCS_PASSWORD=
# Isian "Database" di form login OCS
OCS_COMPANY_DB=EJI_WMS

# ── doi-monitor (daftar Phase Out) ────────────────────────────────────────────
# Akun login doi-monitor.vercel.app — cukup peran "Lihat saja".
DOI_MONITOR_URL=https://
DOI_MONITOR_USERNAME=
DOI_MONITOR_PASSWORD=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Vercel Cron memanggil /api/cron/sync dengan header Authorization: Bearer <CRON_SECRET>.
# Cron luar (cron-job.org) bisa memanggil /api/cron/sync?key=<CRON_SECRET>.
CRON_SECRET="ganti-dengan-string-acak"
